generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Placeholder model, replace with the real domain.
model Note {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique // stored lowercased and trimmed
  passwordHash String
  createdAt    DateTime   @default(now())
  positions    Position[]
}

model Position {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker      String
  quantity    Float
  unitCost    Float
  purchasedAt DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}
